# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 高德地图 Key
# 申请地址: https://console.amap.com/dev/key/app
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_KEY_PLACES=

# Umami 统计
PUBLIC_UMAMI_BASE=
PUBLIC_UMAMI_USERNAME=
PUBLIC_UMAMI_PASSWORD=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SHARE_ID=

# Waline 评论
PUBLIC_WALINE_SERVER=

# CloudFlare ImgBed 图床（用于说说/足迹图片上传）
# 部署地址，不带末尾斜杠
PUBLIC_IMAGEBED_URL=
# 上传认证码
PUBLIC_IMAGEBED_AUTH_CODE=
# 上传目录（相对路径，如 "moments"），留空则上传到根目录
PUBLIC_IMAGEBED_FOLDER=手机uu
# API Token（需要 list 权限，用于上传前查重，避免重复上传相同图片）
PUBLIC_IMAGEBED_API_TOKEN=

# 页面加密密码（EncryptGate：加密 /bills/ 与 /life/notebooks/ 页面内容）
# 非 PUBLIC_ 前缀，仅构建时可用、绝不进入客户端；密码丢失无法恢复，请妥善保管
GATE_PASSWORD=
